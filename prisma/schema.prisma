generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// People allowed to sign in. The admin email in src/lib/auth.ts is always
// allowed and is not stored here, so the allowlist can never be locked out.
model AllowedUser {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?   // Filled in from Google on first sign-in
  role        String    @default("user") // "user" or "admin"
  addedBy     String    // Email of the admin who added them
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
}

model Contractor {
  id               String    @id @default(cuid())
  name             String
  hourlyRate       Float
  jobTitle         String
  isActive         Boolean   @default(true)
  startDate        String?
  terminationDate  String?
  paymentMethod    String    @default("Biweekly direct pay")

  // Contact + account details. workPassword is stored as plain text because it
  // has to be readable back; the database file is the security boundary.
  personalEmail    String?
  workEmail        String?
  workPassword     String?
  hasCompanyCard   Boolean   @default(false)
  companyCardNote  String?   // Last 4, issue date, or anything worth noting
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Some contractors are paid under someone else's name — their hours and rate
  // stay on their own record, but the money is sent to the payee. Null means
  // they are paid directly under their own name.
  paidToId        String?
  paidToStartDate String? // "YYYY-MM-DD" — when this arrangement began
  paidToNote      String? // Why, or anything accounting needs to know
  paidTo          Contractor?  @relation("Payee", fields: [paidToId], references: [id])
  paidFor         Contractor[] @relation("Payee")

  payPeriods    PayPeriod[]
  payHistory    PayHistory[]
  accountAccess AccountAccess[]

  @@index([paidToId])
}

model SharedAccount {
  id        String   @id @default(cuid())
  name      String   @unique // "WordPress admin", "Mailchimp", etc.
  username  String?  // Login email/username for the account
  url       String?  // Where to log in
  note      String?
  createdAt DateTime @default(now())

  access AccountAccess[]
}

model AccountAccess {
  id           String   @id @default(cuid())
  accountId    String
  contractorId String
  grantedDate  String   // "YYYY-MM-DD" — when credentials were shared
  revokedDate  String?  // Set once access is removed / password rotated
  note         String?
  createdAt    DateTime @default(now())

  account    SharedAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contractor Contractor    @relation(fields: [contractorId], references: [id], onDelete: Cascade)
}

model PayHistory {
  id           String   @id @default(cuid())
  contractorId String
  type         String   // "raise" or "bonus"
  date         String   // When it happened
  amount       Float    // New hourly rate (for raises) or bonus amount (for bonuses)
  previousRate Float?   // Previous hourly rate (for raises)
  note         String?  // e.g. "upwork", "gusto", context
  createdAt    DateTime @default(now())

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
}

model ProjectCategory {
  id              String @id @default(cuid())
  name            String @unique // Display name: "BTC [Dev]", "BTC Events (#oneshot) [Dev]", etc.
  clockifyProject String? // Clockify project name mapping: "behindthechair.com"
  clockifyClient  String? // Clockify client mapping: "BTC"
  sortOrder       Int     @default(0)
  isDev           Boolean @default(true) // Dev vs Design category

  timeEntries TimeEntry[]
}

model PayPeriod {
  id             String   @id @default(cuid())
  contractorId   String
  startDate      DateTime
  endDate        DateTime
  processingDate DateTime // The date it gets processed (pay date)
  month          String   // "January", "February", etc.
  year           Int
  totalHours     Float
  totalAmount    Float
  source         String   @default("clockify") // "clockify" or "manual"
  createdAt      DateTime @default(now())

  contractor  Contractor  @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]
}

model TimeEntry {
  id                String @id @default(cuid())
  payPeriodId       String
  projectCategoryId String
  description       String?
  hoursDecimal      Float
  amount            Float

  payPeriod       PayPeriod       @relation(fields: [payPeriodId], references: [id], onDelete: Cascade)
  projectCategory ProjectCategory @relation(fields: [projectCategoryId], references: [id])
}
